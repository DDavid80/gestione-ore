function loadData(){
  try{ return JSON.parse(localStorage.getItem(STORE_KEY)) || {}; }
  catch(e){ return {}; }
}
function saveData(){ localStorage.setItem(STORE_KEY, JSON.stringify(DATA)); }

let DATA = loadData();
let currentYear = null;
let currentMonthFilter = ""; 
let yearChartInstance = null;
let monthChartInstances = {};

function todayISO(){
  return new Date().toISOString().slice(0,10);
}
function daysInMonth(y, mIdx){ return new Date(y, mIdx+1, 0).getDate(); }
function isWeekday(y, mIdx, d){
  const wd = new Date(y, mIdx, d).getDay();
  return wd !== 0 && wd !== 6;
}

function buildFullMonthEntries(y, mIdx){
  const entries = [];
  const dim = daysInMonth(y, mIdx);
  for(let d=1; d<=dim; d++){
    const iso = y + '-' + String(mIdx+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
    entries.push({date: iso, ore: 0, rep:false, recup:false, lavorato:false, ferie:false, note:''});
  }
  return entries;
}
function buildAllDaysEntries(y, mIdx){
  const entries = [];
  const dim = daysInMonth(y, mIdx);
  for(let d=1; d<=dim; d++){
    const iso = y + '-' + String(mIdx+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
    entries.push({date: iso, rep:false});
  }
  return entries;
}
function formatDateIT(iso){
  if(!iso) return '';
  const p = iso.split('-');
  if(p.length!==3) return iso;
  return p[2] + '/' + p[1] + '/' + p[0];
}

function emptyYear(y){
  return {
    rateHistory: [{from: y+'-01-01', rate:0}],
    months: MONTHS.map((m,mIdx)=>({entries: buildFullMonthEntries(y, mIdx), closed:false})),
    notes: [],
    reperibilitaDays: MONTHS.map((m,mIdx)=>({entries: buildAllDaysEntries(y, mIdx)})),
    ferie: {
      residuoPrec: {ferie:0, per:0, semifestivita:0, rechh:0},
      spettanza: {ferie:0, per:0, semifestivita:0, rechh:0},
      usufruitoMonths: MONTHS.map(()=>({ferie:0, per:0, semifestivita:0, rechh:0}))
    },
    ticketRateHistory: [{from: y+'-01-01', rate:0}],
    ticketMonths: MONTHS.map(()=>0)
  };
}

function ensureYear(y){
  if(y===undefined || y===null || y==='' || isNaN(Number(y))){
    y = currentYear && !isNaN(Number(currentYear)) ? currentYear : new Date().getFullYear();
  }
  if(!DATA[y]) DATA[y] = emptyYear(y);
  const Y = DATA[y];
  if(!Y.rateHistory){
    const oldRate = Y.rate || 0;
    Y.rateHistory = [{from: y+'-01-01', rate: oldRate}];
    delete Y.rate;
  }
  if(!Y.notes) Y.notes = [];
  if(!Y.months) Y.months = MONTHS.map((m,mIdx)=>({entries:buildFullMonthEntries(y,mIdx),closed:false}));
  Y.months.forEach((m,mIdx)=>{
    if(!m.entries) m.entries=buildFullMonthEntries(y,mIdx);
    if(m.closed===undefined) m.closed=false;
    m.entries.forEach(e=>{ if(e.lavorato===undefined) e.lavorato=false; if(e.ferie===undefined) e.ferie=false; });
    const existingDates = new Set(m.entries.map(e=>e.date).filter(Boolean));
    buildFullMonthEntries(Number(y),mIdx).forEach(day=>{
      if(!existingDates.has(day.date)) m.entries.push(day);
    });
    m.entries.sort((a,b)=>(a.date||'9999-99-99').localeCompare(b.date||'9999-99-99'));
  });
  if(!Y.reperibilitaDays) Y.reperibilitaDays = MONTHS.map((m,mIdx)=>({entries: buildAllDaysEntries(y, mIdx)}));
  Y.reperibilitaDays.forEach((m, mIdx)=>{
    const dim = daysInMonth(y, mIdx);
    if(m.entries.length < dim){
      const full = buildAllDaysEntries(y, mIdx);
      m.entries.forEach(old=>{
        const match = full.find(f=>f.date===old.date);
        if(match) match.rep = !!old.rep;
      });
      m.entries = full;
    }
  });
  if(!Y.ferie) Y.ferie = {
    residuoPrec: {ferie:0, per:0, semifestivita:0, rechh:0},
    spettanza: {ferie:0, per:0, semifestivita:0, rechh:0},
    usufruitoMonths: MONTHS.map(()=>({ferie:0, per:0, semifestivita:0, rechh:0}))
  };
  if(!Y.ticketRateHistory) Y.ticketRateHistory = [{from: y+'-01-01', rate:0}];
  if(!Y.ticketMonths) Y.ticketMonths = MONTHS.map(()=>0);
  return Y;
}

function migrateHistoricalTicketClosures(force=false){
  const now = new Date();
  const currentCalendarYear = now.getFullYear();
  const currentCalendarMonth = now.getMonth();
  Object.keys(DATA).forEach(yearKey=>{
    const yearNum = Number(yearKey);
    if(isNaN(yearNum)) return;
    const Y = ensureYear(yearNum);
    Y.months.forEach((month,mIdx)=>{
      const isHistorical = yearNum < currentCalendarYear || (yearNum===currentCalendarYear && mIdx<currentCalendarMonth);
      if(!isHistorical) return;
      month.closed = true;
      const savedTicketDays = parseFloat(Y.ticketMonths[mIdx])||0;
      const checkedWorkDays = (month.entries||[]).filter(e=>!!e.lavorato).length;
      if(savedTicketDays>0 && checkedWorkDays===0) month.ticketManualProtected = true;
      if(savedTicketDays===0 && checkedWorkDays>0) Y.ticketMonths[mIdx] = checkedWorkDays;
    });
  });
  localStorage.setItem(TICKET_CLOSURE_MIGRATION_KEY, new Date().toISOString());
  saveData();
}

function seedIfNeeded(){
  if(localStorage.getItem(SEEDED_KEY)) return;
  Object.keys(SEED_DATA_RAW).forEach(y=>{
    if(DATA[y]) return;
    const seed = SEED_DATA_RAW[y];
    const yearObj = { rateHistory: [{from: y+'-01-01', rate: seed.rate}], months: [] };
    seed.months.forEach((m, mIdx)=>{
      const full = buildFullMonthEntries(parseInt(y,10), mIdx);
      m.entries.forEach(se=>{
        const match = full.find(f=>f.date===se.date);
        if(match){ match.ore = se.ore; match.rep = !!se.rep; }
        else { full.push({date: se.date, ore: se.ore, rep: !!se.rep, recup:false, note:''}); }
      });
      full.forEach(f=>{ if(f.recup===undefined) f.recup=false; if(f.lavorato===undefined) f.lavorato=false; if(f.note===undefined) f.note=''; });
      yearObj.months.push({entries: full, closed:false});
    });
    DATA[y] = yearObj;
  });
  localStorage.setItem(SEEDED_KEY, '1');
  saveData();
}

function purgeInvalidYears(){
  Object.keys(DATA).forEach(k=>{
    if(isNaN(Number(k)) || k.trim()===''){ delete DATA[k]; }
  });
}

function initYears(){
  purgeInvalidYears();
  seedIfNeeded();
  purgeInvalidYears();
  let years = Object.keys(DATA).map(Number).filter(n=>!isNaN(n)).sort((a,b)=>a-b);
  if(years.length===0){
    const now = new Date().getFullYear();
    ensureYear(now);
    years = [now];
  }
  currentYear = years[years.length-1];
  migrateHistoricalTicketClosures();
  saveData();
}

function addYear(){
  const v = document.getElementById('newYearInput').value.trim();
  if(!v || isNaN(v)){ showToast('Inserisci un anno valido.'); return; }
  const y = parseInt(v,10);
  ensureYear(y);
  currentYear = y;
  document.getElementById('newYearInput').value='';
  saveData();
  renderAll();
  showToast('Anno ' + y + ' creato.');
}

function deleteYear(y, ev){
  ev.stopPropagation();
  ev.preventDefault();
  if(!confirm('Eliminare tutti i dati dell\'anno ' + y + '?')) return;
  delete DATA[y];
  purgeInvalidYears();
  if(Object.keys(DATA).length===0){ ensureYear(new Date().getFullYear()); }
  const years = Object.keys(DATA).map(Number).filter(n=>!isNaN(n)).sort((a,b)=>a-b);
  currentYear = years[years.length-1];
  saveData();
  renderAll();
}

function selectYear(y){
  if(isNaN(Number(y))) return;
  currentYear = Number(y);
  renderAll();
}

function rateForDate(y, dateStr){
  const hist = ensureYear(y).rateHistory.slice().sort((a,b)=> a.from.localeCompare(b.from));
  if(!dateStr) dateStr = todayISO();
  let applicable = hist[0] ? hist[0].rate : 0;
  for(const h of hist){
    if(h.from <= dateStr) applicable = h.rate; else break;
  }
  return applicable;
}
function currentRate(y){
  return rateForDate(y, todayISO());
}

/* RICALCOLO RETROATTIVO COMPLETO E AUTOCOMPILAZIONE DATE */
function updateRate(){
  const v = parseFloat(document.getElementById('rateInput').value);
  if(isNaN(v)){ showToast('Inserisci una tariffa valida.'); return; }
  const y = ensureYear(currentYear);
  
  // Seleziona il mese target (quello filtrato o il mese corrente)
  let targetMonthIdx = currentMonthFilter !== '' ? parseInt(currentMonthFilter, 10) : new Date().getMonth();
  const monthStr = String(targetMonthIdx + 1).padStart(2, '0');
  const monthStartISO = `${curre