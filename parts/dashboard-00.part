<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gestione Ore</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>window.__STRAO_HAD_DATA=!!localStorage.getItem('strao_data_v3');</script>
<style>
:root{
  --bg:#050b14; --side:#081426; --card:#122137; --card-border:#233b5d; --line:#233654;
  --txt:#eef4ff; --txt-muted:#94a3b8; --acc:#4f8cf8; --acc-hover:#3b74db;
  --success:#10b981; --warning:#f59e0b; --danger:#ef4444; --purple:#8b5cf6; --font:'Inter',system-ui,sans-serif;
  --shadow:0 16px 42px rgba(0,0,0,.22); --soft-glow:0 0 24px rgba(79,140,248,.10);
}
[data-theme="grigio"]{
  --bg:#1b1c1e; --side:#212224; --card:#28292c; --card-border:#3a3b3e; --line:#3a3b3e;
}
[data-theme="tortora"]{
  --bg:#f4f1ec; --side:#eae5dc; --card:#fbf9f5; --card-border:#d9d1c3; --line:#d9d1c3;
  --txt:#3f3a33; --txt-muted:#8a8072; --acc:#a68a6d; --acc-hover:#8f745a;
  --success:#7a9174; --warning:#c19352; --danger:#b56a5c; --purple:#8a76a3;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:var(--font);background:
  radial-gradient(circle at 78% -10%,rgba(79,140,248,.13),transparent 30%),
  radial-gradient(circle at 18% 105%,rgba(16,185,129,.07),transparent 26%),var(--bg);
  color:var(--txt);display:flex;min-height:100vh;transition:background .2s,color .2s;}
.side{width:260px;height:100vh;position:fixed;top:0;left:0;background:linear-gradient(180deg,var(--side),color-mix(in srgb,var(--side) 88%,#000));border-right:1px solid var(--line);display:flex;flex-direction:column;padding:20px 16px;overflow-y:auto;box-shadow:10px 0 35px rgba(0,0,0,.14);}

.brand{display:flex;align-items:center;gap:10px;padding-bottom:16px;border-bottom:1px solid var(--line);margin-bottom:16px;}
.brand-logo{width:44px;height:44px;border-radius:10px;background:var(--card);border:1px solid var(--card-border);display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;flex-shrink:0;position:relative;}
.brand-logo img{width:100%;height:100%;object-fit:cover;}
.brand-logo i{color:var(--txt-muted);font-size:1rem;}
.brand-logo:hover{border-color:var(--acc);}
.brand-name{flex:1;min-width:0;}
.logo-tag{color:var(--acc);font-weight:800;font-size:.68rem;letter-spacing:1.5px;text-transform:uppercase;}
.brand-title{font-size:1.05rem;font-weight:800;outline:none;border:1px solid transparent;border-radius:6px;padding:2px 4px;margin-left:-4px;cursor:text;line-height:1.25;}
.brand-title:hover,.brand-title:focus{border-color:var(--card-border);}
#logoFileInput{display:none;}

.side label{font-size:.7rem;text-transform:uppercase;color:var(--txt-muted);letter-spacing:.5px;font-weight:700;display:block;margin:14px 0 6px;}
.side input, .side select{width:100%;background:var(--card);border:1px solid var(--line);color:var(--txt);padding:8px 10px;border-radius:8px;font-size:.85rem;}
.year-list{margin-top:6px;}
.year-item{padding:10px 12px;border-radius:10px;background:var(--card);cursor:pointer;font-weight:600;font-size:.88rem;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;border:1px solid transparent;transition:.18s ease;}
.year-item:hover{border-color:var(--acc);transform:translateX(2px);}
.year-item.active{background:linear-gradient(135deg,var(--acc),var(--acc-hover));color:#fff;box-shadow:0 8px 22px rgba(79,140,248,.25);}
.year-item .del{opacity:.6;font-size:.75rem;}
.year-item .del:hover{color:var(--danger);opacity:1;}
.add-year{display:flex;gap:6px;margin-top:8px;}
.add-year input{flex:1;}
.btn-sm{background:var(--acc);border:none;color:#fff;font-weight:700;padding:8px 10px;border-radius:8px;cursor:pointer;font-size:.8rem;}
.btn-sm:hover{background:var(--acc-hover);}

.theme-row{display:flex;gap:8px;margin-top:6px;}
.theme-dot{width:30px;height:30px;border-radius:50%;cursor:pointer;border:2px solid transparent;flex-shrink:0;}
.theme-dot.active{border-color:var(--txt);}
.theme-dot.navy{background:linear-gradient(135deg,#07111f,#4f8cf8);}
.theme-dot.grigio{background:linear-gradient(135deg,#1b1c1e,#3a3b3e);}
.theme-dot.tortora{background:linear-gradient(135deg,#eae5dc,#a68a6d);}

.side-foot{margin-top:auto;padding-top:14px;border-top:1px solid var(--line);font-size:.72rem;color:var(--txt-muted);}

.rep-side{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
.rep-side .rm{background:var(--card);border:1px solid var(--card-border);border-radius:8px;padding:6px 8px;}
.rep-side .rm .n{font-size:.68rem;color:var(--txt-muted);text-transform:uppercase;}
.rep-side .rm input{width:100%;background:var(--bg);border:1px solid var(--line);color:var(--txt);border-radius:6px;padding:4px 6px;font-size:.78rem;margin-top:3px;}

.main{margin-left:260px;padding:30px 36px;width:calc(100% - 260px);}
.top{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:22px;flex-wrap:wrap;gap:12px;}
.top p{color:var(--txt-muted);font-size:.85rem;margin-top:4px;}
.actions{display:flex;gap:10px;flex-wrap:wrap;}
.btn{background:var(--card);border:1px solid var(--card-border);color:var(--txt);padding:10px 14px;border-radius:8px;cursor:pointer;font-size:.85rem;font-weight:600;display:flex;align-items:center;gap:8px;}
.btn:hover{border-color:var(--acc);color:var(--acc);}
.btn.primary{background:var(--acc);border-color:var(--acc);color:#fff;}
.btn.primary:hover{background:var(--acc-hover);}

.summary{display:grid;grid-template-columns:repeat(7,1fr);gap:14px;margin-bottom:22px;}
.stat{background:linear-gradient(145deg,color-mix(in srgb,var(--card) 96%,#fff),var(--card));border:1px solid var(--card-border);border-radius:15px;padding:16px 17px;box-shadow:var(--soft-glow);position:relative;overflow:hidden;transition:.18s ease;}
.stat::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:linear-gradient(90deg,var(--acc),transparent);opacity:.65;}
.stat:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--acc) 60%,var(--card-border));}
.stat .lbl{font-size:.68rem;text-transform:uppercase;color:var(--txt-muted);letter-spacing:.5px;font-weight:700;}
.stat .val{font-size:1.3rem;font-weight:800;margin-top:6px;}
.summary .stat:nth-child(1) .lbl,.summary .stat:nth-child(1) .val{color:#38bdf8;}
.summary .stat:nth-child(2) .lbl,.summary .stat:nth-child(2) .val{color:#2dd4bf;}
.summary .stat:nth-child(3) .lbl,.summary .stat:nth-child(3) .val{color:#c084fc;}
.summary .stat:nth-child(4) .lbl,.summary .stat:nth-child(4) .val{color:var(--acc);}
.summary .stat:nth-child(5) .lbl,.summary .stat:nth-child(5) .val{color:var(--success);}
.summary .stat:nth-child(6) .lbl,.summary .stat:nth-child(6) .val{color:var(--warning);}
.summary .stat:nth-child(7) .lbl,.summary .stat:nth-child(7) .val{color:var(--purple);}
.stat.rate .val{color:var(--acc);}
.stat.euro .val{color:var(--success);}
.stat.rep .val{color:var(--warning);}
.stat.recup .val{color:var(--purple);}

.rate-box{background:var(--card);border:1px solid var(--card-border);border-radius:12px;padding:16px 18px;margin-bottom:22px;display:flex;gap:26px;flex-wrap:wrap;align-items:center;}
.rate-box .field{display:flex;flex-direction:column;gap:6px;}
.rate-box label{font-size:.72rem;text-transform:uppercase;color:var(--txt-muted);letter-spacing:.5px;font-weight:700;}
.rate-box input{background:var(--bg);border:1px solid var(--line);color:var(--txt);padding:8px 10px;border-radius:8px;font-size:.9rem;width:140px;}
.rate-box .note{color:var(--txt-muted);font-size:.78rem;max-width:420px;}
.rate-history{font-size:.75rem;color:var(--txt-muted);}
.rate-history b{color:var(--txt);}

.chart-card{background:linear-gradient(145deg,color-mix(in srgb,var(--card) 97%,#fff),var(--card));border:1px solid var(--card-border);border-radius:16px;padding:18px 20px;margin-bottom:26px;box-shadow:var(--shadow);}
.chart-card h3{font-size:.95rem;font-weight:700;margin-bottom:10px;}
.chart-card .ch-wrap{height:230px;}

.month-summary{display:none;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px;}
.month-summary.show{display:grid;}
.month-summary .stat{border-color:var(--acc);}

.section-card{background:linear-gradient(145deg,color-mix(in srgb,var(--card) 97%,#fff),var(--card));border:1px solid var(--card-border);border-radius:16px;padding:17px 19px;margin-bottom:26px;box-shadow:var(--shadow);transition:border-color .18s ease;}
.section-card:hover{border-color:color-mix(in srgb,var(--acc) 42%,var(--card-border));}
.section-card h3{font-size:1rem;font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px;}
.section-card h3.sec-toggle{cursor:pointer;user-select:none;margin-bottom:0;}
.sec-chevron{margin-left:auto;transition:transform .15s;font-size:.85rem;color:var(--txt-muted);}
.sec-chevron.closed{transform:rotate(-90deg);}
.section-inline-summary{margin-left:auto;display:flex;gap:7px;align-items:center;flex-wrap:wrap;justify-content:flex-end;}
.summary-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:6px 10px;font-size:.72rem;color:var(--txt-muted);font-weight:700;white-space:nowrap;}
.summary-pill strong{color:var(--txt);font-size:.78rem;}
.summary-pill.ferie{border-color:color-mix(in srgb,var(--success) 45%,var(--line));}
.summary-pill.ferie i,.summary-pill.ticket i{color:var(--success);}
.summary-pill.recupero{border-color:color-mix(in srgb,var(--purple) 52%,var(--line));}
.summary-pill.recupero i{color:var(--purple);}
.summary-pill.ticket{border-color:color-mix(in srgb,var(--success) 45%,var(--line));}
.summary-pill.note{border-color:color-mix(in srgb,var(--warning) 52%,var(--line));}
.summary-pill.note i,.summary-pill.note strong{color:var(--warning);}
.summary-pill.note.empty{border-color:var(--line);opacity:.72;}
.summary-pill.note.empty i,.summary-pill.note.empty strong{color:var(--txt-muted);}
.summary-pill.ore{border-color:color-mix(in srgb,#38bdf8 50%,var(--line));}
.summary-pill.ore i,.summary-pill.ore strong{color:#38bdf8;}
.summary-pill.guadagno{border-color:color-mix(in srgb,var(--success) 50%,var(--line));}
.summary-pill.guadagno i,.summary-pill.guadagno strong{color:var(--success);}
.sec-body{margin-top:14px;}
.sec-body.closed{display:none;}
.section-card .sub-note{color:var(--txt-muted);font-size:.8rem;margin-bottom:14px;}
.section-card table{width:100%;}
.section-card th{white-space:nowrap;}
.section-card td input[type=number]{width:100%;}
.note-item{display:flex;gap:10px;align-items:flex-start;background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:8px 10px;margin-bottom:8px;}
.note-item input[type=date]{background:var(--card);border:1px solid var(--line);color:var(--txt);border-radius:6px;padding:5px 6px;font-size:.78rem;width:130px;flex-shrink:0;}
.note-item textarea{flex:1;background:var(--card);border:1px solid var(--line);color:var(--txt);border-radius:6px;padding:6px 8px;font-size:.82rem;resize:vertical;min-height:36px;font-family:var(--font);}
.ferie-table td, .ferie-table th{text-align:center;padding:8px 6px;}
.ferie-table td:first-child, .ferie-table th:first-child{text-align:left;}
.ferie-table tr.saldo td{font-weight:800;color:var(--success);border-top:2px solid var(--line);}
.ferie-table input[type=number]{color:var(--success);font-weight:700;}
.ticket-box{display:flex;gap:26px;flex-wrap:wrap;align-items:center;margin-bottom:16px;}
.ticket-box .field{display:flex;flex-direction:column;gap:6px;}
.ticket-box input{background:var(--bg);border:1px solid var(--line);color:var(--txt);padding:8px 10px;border-radius:8px;font-size:.9rem;width:140px;}
.ticket-total{background:linear-gradient(135deg,color-mix(in srgb,var(--success) 9%,var(--bg)),var(--bg));border:1px solid color-mix(in srgb,var(--success) 42%,var(--line));border-radius:12px;padding:14px 17px;font-weight:800;font-size:1.1rem;color:var(--success);box-shadow:0 8px 24px rgba(16,185,129,.08);}
.rep-day-row{display:flex;align-items:center;justify-content:space-between;padding:5px 4px;border-bottom:1px solid var(--line);font-size:.82rem;}
.rep-day-row label{display:flex;align-items:center;gap:8px;cursor:pointer;}

.months{display:grid;grid-template-columns:repeat(auto-fill,minmax(420px,1fr));gap:18px;align-items:start;}
.month-card{background:var(--card);border:1px solid var(--card-border);border-radius:12px;overflow:hidden;height:fit-content;}
.month-head{padding:12px 16px;background:rgba(0,0,0,.12);display:flex;justify-content:space-between;align-items:center;cursor:pointer;}
[data-theme="tortora"] .month-head{background:rgba(0,0,0,.04);}
.month-head h3{font-size:.95rem;font-weight:700;}
.month-head .sub{font-size:.78rem;color:var(--txt-muted);margin-top:2px;}
.month-body{padding:12px 16px;display:none;}
.month-body.open{display:block;}
.ch-wrap small{height:140px;margin-bottom:12px;}
table{width:100%;border-collapse:collapse;font-size:.8rem;}
th{text-align:left;color:var(--txt-muted);font-size:.68rem;text-transform:uppercase;letter-spacing:.5px;padding:6px 4px;border-bottom:1px solid var(--line);}
td{padding:4px;border-bottom:1px solid var(--line);}
td input[type=date]{background:var(--bg);border:1px solid var(--line);color:var(--txt);padding:5px 6px;border-radius:6px;width:100%;font-size:.78rem;}
td input[type=number]{background:var(--bg);border:1px solid var(--line);color:var(--txt);padding:5px 6px;border-radius:6px;width:64px;font-size:.78rem;}
td input[type=text]{background:var(--bg);border:1px solid var(--line);color:var(--txt);padding:5px 6px;border-radius:6px;width:100%;font-size:.78rem;}
td.chk{text-align:center;}
.row-del{color:var(--txt-muted);cursor:pointer;background:none;border:none;font-size:.9rem;}
.row-del:hover{color:var(--danger);}
.month-tot{display:flex;flex-wrap:wrap;gap:10px 16px;justify-content:space-between;margin-top:10px;padding-top:10px;border-top:1px solid var(--line);font-size:.8rem;font-weight:700;}
.month-tot span.e{color:var(--success);}
.month-tot span.r{color:var(--warning);}
.month-tot span.rc{color:var(--purple);}
.workday-check{accent-color:var(--success);width:18px;height:18px;cursor:pointer;}
.workday-check:disabled{cursor:not-allowed;opacity:.6;}
.month-closebar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;padding:11px 12px;border:1px solid var(--line);border-radius:12px;background:color-mix(in srgb,var(--success) 7%,var(--bg));}
.month-closebar .work-count{font-size:.8rem;color:var(--txt-muted);}
.month-closebar .work-count strong{color:var(--success);font-size:.95rem;}
.month-close-btn{border:1px solid color-mix(in srgb,var(--success) 55%,var(--line));background:color-mix(in srgb,var(--success) 13%,var(--bg));color:var(--success);font-weight:800;padding:8px 12px;border-radius:10px;cursor:pointer;white-space:nowrap;}
.month-close-btn.closed{border-color:color-mix(in srgb,var(--warning) 55%,var(--line));background:color-mix(in srgb,var(--warning) 11%,var(--bg));color:var(--warning);}
.closed-mark{display:inline-flex;align-items:center;gap:5px;margin-left:8px;padding:3px 7px;border-radius:999px;background:color-mix(in srgb,var(--success) 12%,transparent);border:1px solid color-mix(in srgb,var(--success) 40%,var(--line));color:var(--success);font-size:.62rem;vertical-align:middle;}
.ticket-auto{display:inline-flex;align-items:center;gap:5px;color:var(--success);font-size:.68rem;font-weight:700;}
.ticket-wait{color:var(--warning);font-size:.7rem;font-weight:700;}
.add-row{width:100%;margin-top:10px;padding:7px;border-radius:8px;border:1px dashed var(--card-border);background:none;color:var(--txt-muted);cursor:pointer;font-size:.8rem;}
.add-row:hover{border-color:var(--acc);color:var(--acc);}
.toast{position:fixed;bottom:24px;right:24px;background:var(--card);border:1px solid var(--acc);color:var(--txt);padding:12px 18px;border-radius:10px;font-size:.85rem;display:none;z-index:99;}
@media(max-width:1100px){
  .summary{grid-template-columns:repeat(4,1fr)}
  .main{padding:24px 22px}
}
@media(max-width:760px){
  body{display:block;padding-bottom:calc(18px + env(safe-area-inset-bottom))}
  .side{position:relative;width:100%;height:auto;padding:14px 16px;box-shadow:none;border-right:0;border-bottom:1px solid var(--line)}
  .side-foot{display:none}.year-list{display:flex;gap:7px;overflow-x:auto;padding-bottom:3px}.year-item{min-width:88px;margin:0}
  .add-year{max-width:240px}.theme-row{margin-bottom:4px}.rep-side{grid-template-columns:repeat(4,minmax(90px,1fr));overflow-x:auto}
  .main{margin-left:0;width:100%;padding:20px 14px}.top{align-items:flex-start}.top h1{font-size:1.55rem}.actions{width:100%}.btn{min-height:44px;flex:1;justify-content:center}
  .summary,.month-summary{grid-template-columns:repeat(2,1fr);gap:10px}.stat{padding:14px 13px}.stat .val{font-size:1.12rem}
  .months{grid-template-columns:1fr}.month-card{border-radius:14px}.section-card,.chart-card{padding:15px 13px;border-radius:14px}
  .section-card h3{align-items:flex-start;flex-wrap:wrap}.section-inline-summary{width:100%;order:3;margin:8px 0 0;justify-content:flex-start}.sec-chevron{position:absolute;right:28px}
  .summary-pill{padding:6px 9px}.ticket-box{gap:14px}.ticket-box .field,.ticket-box input{width:100%}
  .note-item{flex-wrap:wrap}.note-item textarea{min-width:100%}.chart-card .ch-wrap{height:205px}
}
@media(max-width:430px){
  .summary{grid-template-columns:1fr 1fr}.month-summary.show{grid-template-columns:1fr 1fr}.btn{font-size:.78rem;padding:9px 8px}.summary-pill{font-size:.68rem}
}
</style>
<style id="ios-glass-design">
:root{
  --bg:#05070d;--side:rgba(13,20,34,.72);--card:rgba(26,35,52,.62);--card-border:rgba(255,255,255,.13);--line:rgba(255,255,255,.11);
  --txt:#f5f7ff;--txt-muted:#a9b4c7;--acc:#0a84ff;--acc-hover:#409cff;--success:#30d158;--warning:#ff9f0a;--danger:#ff453a;--purple:#bf5af2;
  --shadow:0 20px 55px rgb