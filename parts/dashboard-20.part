giorni'}${monthDays?` · ${monthDays} in questo mese`:''}</span></div>`;
}

function renderCoverOncall(){
  const box=document.getElementById('coverOncall');if(!box)return;
  let info=null;try{info=agendaOncallInfo();}catch(e){}
  if(!info){box.hidden=true;box.innerHTML='';return;}
  const when=info.now?'Sei reperibile adesso':(info.until===1?'Reperibile da domani':'Prossima reperibilità tra '+info.until+' giorni');
  box.hidden=false;box.className='cover-oncall'+(info.now?' now':'');
  box.innerHTML=`<i class="fa-solid fa-phone-volume"></i><div><strong>${when}</strong><span>${agendaFmtDay(info.from)} → ${agendaFmtDay(info.to)} · ${info.len} ${info.len===1?'giorno':'giorni'}</span></div>`;
}
function exportRepIcs(){
  const days=[];
  Object.keys(DATA).sort().forEach(yr=>{const y=DATA[yr];((y&&y.reperibilitaDays)||[]).forEach(m=>((m&&m.entries)||[]).forEach(e=>{if(e&&e.rep&&e.date)days.push(e.date);}));});
  const u=[...new Set(days)].sort();
  if(!u.length){alert('Nessun giorno di reperibilità da esportare.');return;}
  const blocks=[];let from=u[0],prev=u[0];
  for(let i=1;i<u.length;i++){if(u[i]===addDaysISO(prev,1)){prev=u[i];continue;}blocks.push([from,prev]);from=prev=u[i];}
  blocks.push([from,prev]);
  const c=iso=>iso.replace(/-/g,''),stamp=new Date().toISOString().replace(/[-:]/g,'').slice(0,15)+'Z';
  const L=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Gestione Ore//Reperibilita//IT','CALSCALE:GREGORIAN'];
  blocks.forEach(b=>{
    const n=Math.round((new Date(b[1]+'T12:00:00')-new Date(b[0]+'T12:00:00'))/86400000)+1;
    L.push('BEGIN:VEVENT','UID:rep-'+c(b[0])+'@gestione-ore','DTSTAMP:'+stamp,'DTSTART;VALUE=DATE:'+c(b[0]),'DTEND;VALUE=DATE:'+c(addDaysISO(b[1],1)),'SUMMARY:Reperibilità ('+n+(n===1?' giorno)':' giorni)'),'TRANSP:TRANSPARENT','BEGIN:VALARM','ACTION:DISPLAY','DESCRIPTION:Reperibilità da domani','TRIGGER:-PT15H','END:VALARM','END:VEVENT');
  });
  L.push('END:VCALENDAR');
  const blob=new Blob([L.join('\r\n')+'\r\n'],{type:'text/calendar;charset=utf-8'}),a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download='reperibilita.ics';document.body.appendChild(a);a.click();
  setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},1000);
}
function agendaFerieCount(mIdx){const y=ensureYear(currentYear),m=y.months[mIdx];return ((m&&m.entries)||[]).filter(e=>e.ferie).length;}
const memoJournalKey='gestioneOre.noteEliminate.v1';
function memoJournal(){try{return JSON.parse(localStorage.getItem(memoJournalKey)||'[]')}catch{return []}}
function rememberMemoDeletion(yr,kind,item,idx){
 const record={yr,kind,date:item.date,text:kind==='registro'?item.note:item.text,id:item.id,idx};
 const items=memoJournal();if(!items.some(x=>JSON.stringify(x)===JSON.stringify(record)))localStorage.setItem(memoJournalKey,JSON.stringify([...items,record]));
}
function applyMemoDeletions(data){
 let changed=false;
 for(const d of memoJournal()){const y=data[d.yr];if(!y)continue;
 if(d.kind==='registro'){const rows=y.months?.[Number(d.date.slice(5,7))-1]?.entries||[],e=rows.filter(e=>e.date===d.date)[d.idx];if(e&&e.note===d.text){e.note='';changed=true}}
 else if(Array.isArray(y.notes)){const before=y.notes.length;y.notes=y.notes.filter(n=>!(String(n.id)===String(d.id)&&n.date===d.date&&n.text===d.text));if(before!==y.notes.length)changed=true}
 }return changed;
}
function dayMemoButton(iso){
 const y=DATA[iso.slice(0,4)],m=Number(iso.slice(5,7))-1;
 const present=y?.notes?.some(n=>n.date===iso&&n.text?.trim())||y?.months?.[m]?.entries?.some(e=>e.date===iso&&e.note?.trim());
 return `<button type="button" class="day-memo ${present?'present':''}" aria-label="${present?'Leggi note':'Aggiungi nota'} ${iso}" title="${present?'Leggi note':'Aggiungi nota'}" onclick="openDayMemo('${iso}')">${present?'✎':'+'}</button>`;
}
function openDayMemo(iso){
 const y=ensureYear(Number(iso.slice(0,4))),m=Number(iso.slice(5,7))-1,dialog=document.createElement('dialog');
 dialog.className='rep-dialog memo-dialog';dialog.setAttribute('aria-label','Note del giorno');
 dialog.innerHTML=`<style>
dialog.memo-dialog{padding:0;border:1px solid #38424e;border-radius:16px;width:min(440px,calc(100vw - 28px));max-height:80dvh;color:#eef2f7;background:#191e25;box-shadow:0 18px 65px #0006}
dialog.memo-dialog[open]{display:flex;flex-direction:column}
.memo-dialog .memo-heading{padding:20px 22px 14px}.memo-dialog .memo-heading small{font:600 11px/1.4 system-ui;letter-spacing:.1em;color:#acb8c7}.memo-dialog .memo-heading h2{margin:4px 0 0;font:650 20px/1.3 system-ui}
.memo-dialog .memo-fields{padding:0 22px;min-height:0;overflow:auto}.memo-dialog .memo-fields label{font-size:13px;color:#c4ccd5}.memo-dialog .memo-fields textarea{appearance:none;display:block;background:#12161c;color:#f4f6f8;border:1px solid #414c59;border-radius:9px;padding:11px 12px;font:400 16px/1.45 system-ui;resize:vertical;min-height:80px;margin:6px 0 16px}.memo-dialog textarea:focus-visible{outline:2px solid #85baff;outline-offset:-1px}
.memo-dialog .memo-row{position:relative}.memo-dialog .memo-row label{display:block}.memo-dialog .memo-row.has-delete label{min-height:28px;padding-right:36px;display:flex;align-items:center}.memo-dialog .memo-delete{position:absolute;top:0;right:0;width:30px;height:28px;margin:0;padding:0;border:0;border-radius:5px;background:transparent;color:#c4ccd5;font:20px/1 system-ui;cursor:pointer}.memo-dialog .memo-delete:is(:hover,:focus-visible){background:#42272c;color:#ffb4bd}.memo-dialog .memo-actions{display:flex;justify-content:flex-end;gap:8px;border-top:1px solid #343c46;padding:12px 22px}.memo-actions button{width:auto;margin:0;padding:9px 16px;min-height:40px;border-radius:8px;font:600 14px system-ui;cursor:pointer}.memo-cancel{background:transparent;color:#d5dee8;border:1px solid #46525f}.memo-save{background:#a3caff;color:#10253c;border:1px solid transparent}
</style><div class="memo-heading"><small>AGENDA · NOTE</small><h2>${new Date(iso+'T12:00:00').toLocaleDateString('it-IT',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</h2></div><div class="memo-fields"></div><div class="memo-actions"><button type="button" class="memo-cancel">Annulla</button><button type="button" class="memo-save">Salva</button></div>`;
 const fields=dialog.querySelector('.memo-fields'),changes=[];
 function field(label,value,commit){
 const row=document.createElement('div'),l=document.createElement('label'),t=document.createElement('textarea');
 row.className='memo-row';t.id='memo-field-'+changes.length;l.htmlFor=t.id;l.textContent=label;t.value=value;row.append(l,t);fields.append(row);
 let deleted=false;changes.push(()=>commit(deleted?'':t.value.trim()));
 if(value){row.classList.add('has-delete');const x=document.createElement('button');x.type='button';x.className='memo-delete';x.textContent='×';x.title='Elimina nota';x.setAttribute('aria-label','Elimina '+label.toLowerCase()+' '+(changes.length));row.append(x);x.onclick=()=>{deleted=true;const next=row.nextElementSibling;row.remove();next?.querySelector('textarea')?.focus()};}
 }
 for(const e of y.months[m].entries.filter(e=>e.date===iso&&e.note?.trim()))field('Nota del registro',e.note,v=>{if(!v)rememberMemoDeletion(iso.slice(0,4),'registro',e,y.months[m].entries.filter(row=>row.date===iso).indexOf(e));e.note=v});
 for(const n of y.notes.filter(n=>n.date===iso&&n.text?.trim()))field('Nota',n.text,v=>{if(v)n.text=v;else{rememberMemoDeletion(iso.slice(0,4),'agenda',n);y.notes=y.notes.filter(item=>item!==n)}});
 field('Aggiungi nota o promemoria','',v=>{if(v)y.notes.push({id:Date.now()+Math.random(),date:iso,month:String(m),text:v})});
 const [cancel,save]=dialog.querySelectorAll('.memo-actions button');cancel.onclick=()=>dialog.close();save.onclick=()=>{changes.forEach(f=>f());applyMemoDeletions(DATA);saveData();renderAll();dialog.close()};
 document.body.append(dialog);dialog.addEventListener('close',()=>dialog.remove(),{once:true});dialog.showModal();
}
function renderAgendaHome(){
  const host=document.getElementById('agendaHome');if(!host||!currentYear)return;
  const y=ensureYear(currentYear),mIdx=agendaMonthIndex(),month=y.months[mIdx],entries=month.entries||[],title=MONTHS[mIdx].charAt(0)+MONTHS[mIdx].slice(1).toLowerCase();
  const stat=monthTotals(mIdx),worked=workedDays(mIdx),saved=Number(y.ticketMonths&&y.ticketMonths[mIdx])||0;
  const ticketDays=(month.closed||month.ticketManualOverride||month.ticketManualProtected)?saved:worked;
  const ticketRate=ticketRateForDate(currentYear,currentYear+'-'+String(mIdx+1).padStart(2,'0')+'-01'),ticketEuro=ticketDays*ticketRate;
  const notes=(y.notes||[]).filter(n=>(n.text||'').trim()!==''&&(n.month===String(mIdx)||n.date&&Number(n.date.slice(5,7))===mIdx+1)).length;
  document.getElementById('agendaTitle').textContent=title+' '+currentYear;
  document.getElementById('agendaSubtitle').textContent=`${worked} giorni segnati · ${stat.ore.toFixed(2)} ore straordinarie · ${notes} note presenti`+(agendaFerieCount(mIdx)?` · ${agendaFerieCount(mIdx)} ${agendaFerieCount(mIdx)===1?'giorno':'giorni'} di ferie`:'');
  const status=document.getElementById('agendaStatus');status.textContent=month.closed?'MESE CHIUSO':'MESE APERTO';status.classList.toggle('closed',!!month.closed);
  const select=document.getElementById('agendaMonthSelect');if(select){if(select.options.length!==13){select.innerHTML='<option value="">Mese in primo piano</option>'+MONTHS.map((n,i)=>`<option value="${i}">${n.charAt(0)+n.slice(1).toLowerCase()}</option>`).join('');}select.value=currentMonthFilter===''?'':String(mIdx);}
  const kpis=[['fa-business-time',worked+' gg','Giorni lavorati','var(--success)'],['fa-clock',stat.ore.toFixed(2)+' h','Ore straordinarie','var(--acc)'],['fa-ticket','€'+ticketEuro.toFixed(2),'Ticket del mese','var(--warning)'],['fa-umbrella-beach',agendaFerieCount(mIdx)+' gg','Ferie del mese','var(--txt)'],['fa-note-sticky',notes,'Note presenti','var(--purple)']];
  document.getElementById('agendaKpis').innerHTML=kpis.map(k=>`<div class="agenda-kpi" style="--k:${k[3]}"><strong>${k[1]}</strong><span>${k[2]}</span></div>`).join('');
  const offset=(new Date(Number(currentYear),mIdx,1).getDay()+6)%7,days=daysInMonth(Number(currentYear),mIdx),byDate=new Map(entries.map((e,i)=>[e.date,{e,i}]));
  let html=Array(offset).fill('<button class="agenda-day empty" tabindex="-1"></button>').join('');
  const today=todayISO();
  for(let d=1;d<=days;d++){
    const iso=`${currentYear}-${String(mIdx+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`,item=byDate.get(iso),e=item&&item.e||{},wi=weekendInfo(iso);
    const ocNow=agendaIsOnCall(iso);
    const cls=['agenda-day'];if(wi.className.includes('weekend'))cls.push('weekend');if(wi.className.includes('holiday'))cls.push('holiday');if(e.lavorato)cls.push('worked');if(e.ferie)cls.push('ferie');if((Number(e.ore)||0)>0)cls.push('has-hours');if(e.rep)cls.push('rep');if(ocNow){cls.push('oncall');if(!agendaIsOnCall(addDaysISO(iso,-1)))cls.push('oc-start');if(!agendaIsOnCall(addDaysISO(iso,1)))cls.push('oc-end');}if(iso===today)cls.push('today');
    const idx=item?item.i:-1;
    html+=`<div class="memo-day"><button class="${cls.join(' ')}" ${idx>=0?`onclick="openAgendaDay(${mIdx},${idx})"`:''} title="${wi.badge?wi.badge.replace(/<[^>]*>/g,''):iso}"><span class="n">${d}</span>${ocNow?'<i class="fa-solid fa-phone-volume oc"></i>':''}<span class="mark"></span></button>${dayMemoButton(iso)}</div>`;
  }
  document.getElementById('agendaCalendar').innerHTML=html;
  renderAgendaOncall(mIdx);
  renderCoverOncall();
}
function openAgendaSection(id){
  if(id==='repPage'){document.getElementById('coverScreen').classList.add('hidden');showRepPage();return;}
  const body=document.getElementById(id);if(body&&body.classList.contains('closed'))toggleSection(id);
  const page=document.getElementById('repPage');if(page&&page.style.display!=='none')hideRepPage();
  setTimeout(()=>{const el=document.getElementById(id);if(el)el.scrollIntoView({behavior:'smooth',block:'start'});},30);
}
function openAgendaMonth(){
  const mIdx=agendaMonthIndex(),sel=document.getElementById('monthFilter');if(sel)sel.value=String(mIdx);setMonthFilter(String(mIdx));
  const body=document.getElementById('mbody-'+mIdx);if(body)body.classList.add('open');
  const table=document.querySelector(`#mbody-${mIdx} table`);if(table)table.scrollIntoView({behavior:'smooth',block:'start'});
}
function openAgendaDay(mIdx,eIdx){
  const sel=document.getElementById('monthFilter');if(sel)sel.value=String(mIdx);setMonthFilter(String(mIdx));
  const body=document.getElementById('mbody-'+mIdx);if(body)body.classList.add('open');
  setTimeout(()=>{const row=document.getElementById(`dayrow-${mIdx}-${eIdx}`);if(row){row.scrollIntoView({behavior:'smooth',block:'center'});const input=row.querySelector('td:nth-child(3) input');if(input)input.focus({preventScroll:true});}},80);
}
const _agendaRenderAll=renderAll;
renderAll=function(){_agendaRenderAll();renderAgendaHome();};
const _agendaSaveData=saveData;
saveData=function(){_agendaSaveData();if(typeof renderAgendaHome==='function')renderAgendaHome();};
const _agendaSetMonthFilter=setMonthFilter;
setMonthFilter=function(v){_agendaSetMonthFilter(v);renderAgendaHome();};
renderAgendaHome();
if(typeof renderCoverStats==='function'){const _cs=renderCoverStats;renderCoverStats=function(){_cs();renderCoverOncall();};}
renderCoverOncall();
</script>


<script id="google-sync-runtime">
/* Archivio centrale Google Drive */
const GOOGLE_SYNC_URL = 'https://script.google.com/macros/s/AKfycbwlO49qLDWc3TFaA9KqfIVwibsl_7sdl_xqqHbWivZGILsDCpzu7lSKpH8jQBBuXu4m/exec';
let googleSyncReady = false;
let googleSyncTimer = null;
let googleSyncRevision = 0;

function setGoogleSyncStatus(message, state) {
  const el = document.getElementById('googleSyncStatus');
  if (!el) return;
  el.textContent = message;
  el.dataset.state = state || '';
}
function googleSnapshot() {
  const storage = {};
  for (let i = 0; i < localStorage.length; i++) {
    const key = localStorage.key(i);
    if (key && key.startsWith('strao_')) storage[key] = localStorage.getItem(key);
  }
  return {
    app: 'Gestione Ore', backupType: 'snapshot-completo', version: 2,
    createdAt: new Date().toISOString(), data: DATA, brand: loadBrand(),
    theme: localStorage.getItem(THEME_KEY),
    graphicStyle: localStorage.getItem('strao_graphic_style_v1') || 'base',
    view: { year: currentYear, monthFilter: currentMonthFilter }, localStorage: storage
  };
}
async function pullGoogleData() {
  setGoogleSyncStatus('Connessione Google…', 'loading');
  try {
    const response = await fetch(GOOGLE_SYNC_URL + '?action=load', {cache:'no-store'});
    const payload = await response.json();
    const snapshot = payload && payload.data;
    if (!payload || !payload.ok || !snapshot || !snapshot.data) throw new Error('Archivio non disponibile');
    const styleKey='strao_graphic_style_v1';
    const localLook=new Map([THEME_KEY,styleKey].map(k=>[k,localStorage.getItem(k)]).filter(([,v])=>v!==null));
    if (snapshot.localStorage && typeof snapshot.localStorage === 'object') {
      Object.entries(snapshot.localStorage).forEach(([key, value]) => {
        if (!localLook.has(key) && key.startsWith('strao_') && typeof value === 'string') localStorage.setItem(key, value);
      });
    }
    DATA = snapshot.data;
    const repairedNotes=applyMemoDeletions(DATA);
    if (snapshot.brand) saveBrand(snapshot.brand);
    if (!localLook.has(THEME_KEY) && snapshot.theme) localStorage.setItem(THEME_KEY, snapshot.theme);
    if (!localLook.has(styleKey) && snapshot.graphicStyle) localStorage.setItem('strao_graphic_style_v1', snapshot.graphicStyle);
    purgeInvalidYears();
    const nowYear = String(new Date().getFullYear());
    const savedYear = snapshot.view && String(snapshot.view.year || '');
    currentYear = DATA[nowYear] ? Number(nowYear) : (DATA[savedYear] ? Number(savedYear) : Math.max(...Object.keys(DATA).map(Number).filter(Number.isFinite)));
    currentMonthFilter = snapshot.view && snapshot.view.monthFilter !== undefined ? String(snapshot.view.monthFilter) : '';
    localStorage.setItem(STORE_KEY, JSON.stringify(DATA));
    if (typeof initBrand === 'function') initBrand();
    if (typeof initTheme === 'function') initTheme();
    if (typeof setGraphicStyle === 'function') setGraphicStyle(localStorage.getItem('strao_graphic_style_v1') || 'base');
    if (typeof populateMonthFilter === 'function') populateMonthFilter();
    const monthSel = document.getElementById('monthFilter'); if (monthSel) monthSel.value = currentMonthFilter;
    googleSyncRevision = payload.revision || 0; googleSyncReady = true;
    renderAll();
    if (typeof renderCoverStats === 'function') renderCoverStats();
    setGoogleSyncStatus('Google sincronizzato', 'ok');if(repairedNotes)scheduleGoogleSave();
  } catch (error) {
    googleSyncReady = false;
    setGoogleSyncStatus('Salvataggio locale attivo', 'offline');
    console.warn('Google sync:', error);
  }
}
async function pushGoogleData() {
  if (!googleSyncReady) return;
  setGoogleSyncStatus('Salvataggio Google…', 'saving');
  try {
    const response = await fetch(GOOGLE_SYNC_URL, {
      method: 'POST', headers: {'Content-Type':'text/plain;charset=utf-8'},
      body: JSON.stringify({action:'save', data:googleSnapshot(), revision:googleSyncRevision})
    });
    const payload = await response.json();
    if (!payload || !payload.ok) throw new Error('Salvataggio non riuscito');
    googleSyncRevision = payload.revision || googleSyncRevision;
    setGoogleSyncStatus('Google sincronizzato', 'ok');
  } catch (error) {
    setGoogleSyncStatus('Modifiche salvate sul dispositivo', 'offline');
    console.warn('Google save:', error);
  }
}
function scheduleGoogleSave() {
  if (!googleSyncReady) return;
  clearTimeout(googleSyncTimer);
  googleSyncTimer = setTimeout(pushGoogleData, 900);
}
const _googleSyncSaveData = saveData;
saveData = function() { _googleSyncSaveData(); scheduleGoogleSave(); };
setTimeout(pullGoogleData, 180);
</script>

<style id="mobile-data-visibility-v1">
/* Mobile-only presentation fixes. No application logic is changed. */
@media(max-width:760px){
  html,body,.main,.top,.summary,.month-summary,.months,.month-card,
  .section-card,.chart-card,.sec-body{max-width:100%;min-width:0}
  body{overflow-x:hidden}
  .main{overflow-x:visible}
  .side{max-width:100vw;overflow-x:hidden}
  .actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .actions .btn{width:100%;min-width:0}
  .section-card:has(table),.month-body,.sec-body:has(table),
  [style*="overflow-x:auto"],[style*="overflow-x: auto"]{
    overflow-x:auto!important;overflow-y:visible;-webkit-overflow-scrolling:touch;
    overscroll-behavior-x:contain;scrollbar-width:thin;scrollbar-color:var(--acc) transparent
  }
  .section-card:has(table)::-webkit-scrollbar,.month-body::-webkit-scrollbar,
  .sec-body:has(table)::-webkit-scrollbar{height:7px}
  .section-card:has(table)::before,.month-body:has(table)::before{
    content:'↔ Scorri la tabella per vedere tutti i dati';display:block;width:max-content;
    margin:0 0 8px;color:var(--acc);font-size:.68rem;font-weight:800
  }
  table{width:max-content!important;min-width:100%!important}
  th,td{white-space:nowrap;padding-left:7px;padding-right:7px}
  th:first-child,td:first-child{
    position:sticky;left:0;z-index:2;background:var(--card);box-shadow:1px 0 0 var(--line)
  }
  th:first-child{z-index:3;background:color-mix(in srgb,var(--card) 92%,var(--bg))}
  .month-card table{min-width:560px!important}
  .ferie-table{min-width:520px!important}
  .note-item{display:grid;grid-template-columns:1fr auto;width:100%}
  .note-item input[type=date],.note-item textarea{width:100%;min-width:0;max-width:100%}
  .note-item textarea{grid-column:1/-1}
  .rate-box,.ticket-box,.month-closebar{align-items:stretch;flex-direction:column}
  .rate-box .field,.rate-box input,.ticket-box .field,.ticket-box input{width:100%;max-width:100%}
  .agenda-selects{display:grid;grid-template-columns:1fr 1fr}
  .agenda-selects label,.agenda-selects select{width:100%;min-width:0}
  .chart-card .ch-wrap,canvas{max-width:100%!important}
}
@media(max-width:430px){
  .main{padding-left:10px;padding-right:10px}
  .actions{grid-template-columns:1fr}
  .summary,.month-summary.show{grid-template-columns:1fr}
  .summary .stat,.month-summary .stat{grid-column:auto!important}
  .section-card,.chart-card{padding-left:11px;padding-right:11px}
  .agenda-selects{grid-template-columns:1fr}
}
</style>
</html>
