}.agenda-day.worked .mark{background:var(--success);box-shadow:0 0 7px var(--success)}.agenda-day.has-hours:after{content:"";position:absolute;right:6px;top:6px;width:5px;height:5px;border-radius:50%;background:var(--acc)}.memo-day{position:relative;min-width:0}.memo-day>.agenda-day{width:100%}.day-memo{position:absolute;right:2px;bottom:1px;z-index:2;width:22px;height:22px;padding:0;border:0;border-radius:6px;background:transparent;color:var(--muted);font-size:15px;cursor:pointer}.day-memo.present{background:#f6d272;color:#291e08;font-weight:bold}.memo-dialog label,.memo-dialog textarea{display:block;width:100%;box-sizing:border-box}.memo-dialog textarea{margin:5px 0 14px;min-height:60px}.agenda-day.ferie .mark,.agenda-legend i.ferie{background:#fff;border:1px solid #475569;border-radius:1px;transform:rotate(45deg);box-shadow:none}.agenda-day.oncall .mark{left:16px}.agenda-legend i.rep{width:12px;height:3px;border-radius:1px}
.agenda-day.rep{box-shadow:inset 0 -2px var(--warning)}.agenda-day.weekend{color:var(--txt-muted);background:color-mix(in srgb,var(--line) 50%,var(--card))}.agenda-day.holiday{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 38%,transparent)}.agenda-day.today{outline:1px solid var(--warning);outline-offset:1px}.agenda-day.empty{visibility:hidden;pointer-events:none}.agenda-legend{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px;color:var(--txt-muted);font-size:.57rem}.agenda-legend span{display:flex;align-items:center;gap:5px}.agenda-legend i{width:7px;height:7px;border-radius:50%;background:var(--acc)}.agenda-legend i.worked{background:var(--success)}.agenda-legend i.hours{background:var(--acc)}.agenda-legend i.rep{background:var(--warning)}.agenda-legend i.holiday{background:var(--danger)}.agenda-summary-title{font-size:.73rem;font-weight:850;margin-bottom:10px}.agenda-kpis{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.agenda-kpi{border:1px solid color-mix(in srgb,var(--k) 43%,var(--line));border-radius:10px;padding:9px;background:color-mix(in srgb,var(--k) 8%,var(--card))}.agenda-kpi strong{display:block;color:var(--k);font-size:1rem}.agenda-kpi span{display:block;color:var(--txt-muted);font-size:.54rem;text-transform:uppercase;letter-spacing:.04em;margin-top:4px}.agenda-quick{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:9px}.agenda-quick button{display:flex;justify-content:space-between;align-items:center;gap:5px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--txt);padding:8px;font-size:.58rem;cursor:pointer}.agenda-quick button:hover{border-color:var(--acc)}.agenda-quick i{color:var(--acc);margin-right:4px}.agenda-quick b{color:var(--txt-muted);font-size:.53rem;white-space:nowrap}.agenda-month-btn{width:100%;margin-top:8px;padding:9px;border:0;border-radius:8px;background:linear-gradient(100deg,var(--acc),var(--acc-hover));color:#fff;font-size:.65rem;font-weight:850;cursor:pointer}.agenda-month-btn i{margin-left:5px}.agenda-month-btn:hover{filter:brightness(1.08)}
@media(max-width:900px){#coverScreen .cover-inner{grid-template-columns:1fr;grid-template-rows:auto auto auto auto;gap:24px;padding:24px}.cover-hero{max-width:760px}.cover-hero h1{font-size:clamp(2.6rem,8vw,5rem)}#coverScreen .cover-month-card{justify-self:start;max-width:700px}.agenda-layout{grid-template-columns:1fr}.agenda-summary{display:grid;grid-template-columns:1fr 1.2fr;gap:10px;align-items:start}.agenda-summary-title{grid-column:1/-1;margin-bottom:0}.agenda-kpis{grid-column:1}.agenda-quick{grid-column:2;grid-row:2}.agenda-month-btn{grid-column:1/-1}}
@media(max-width:560px){#coverScreen .cover-inner{padding:19px 15px 15px;gap:23px}.cover-datebox strong{font-size:.65rem}.cover-datebox b{font-size:.58rem}.cover-brandblock{gap:8px}.cover-kicker{font-size:.53rem!important}#coverScreen .cover-title{font-size:.9rem!important}.cover-hero h1{font-size:clamp(2.35rem,11vw,3.3rem)}.cover-shortcuts{gap:6px}.cover-shortcuts button{padding:9px 8px;gap:6px}.cover-shortcuts button span{font-size:.63rem}.cover-month-card{padding:15px!important;border-radius:15px!important}#coverScreen .cover-stat{padding:9px;min-height:67px}#coverScreen .cover-stat .cv{font-size:.92rem}.cover-foot{font-size:.54rem!important;flex-direction:column}.agenda-home-head{align-items:flex-start;flex-direction:column}.agenda-selects{width:100%;flex-wrap:wrap}.agenda-selects select{flex:1}.agenda-status{margin-left:auto}.agenda-calendar-wrap{padding:8px}.agenda-weekdays,.agenda-calendar{gap:3px}.agenda-day{min-height:35px;padding:4px}.agenda-day .n{font-size:.6rem}.agenda-summary{display:block}.agenda-summary-title{margin-bottom:9px}.agenda-quick{grid-template-columns:1fr 1fr}.agenda-kpis{grid-template-columns:repeat(2,1fr)}.agenda-legend{gap:8px;font-size:.52rem}}
@media(prefers-reduced-motion:reduce){.agenda-day,.cover-shortcuts button{transition:none}.agenda-day:hover,.cover-shortcuts button:hover{transform:none}}
</style>
<style id="pro-design">
/* ===== Stile Pro · sala controllo ===== */
html[data-graphic-style="pro"] body{--p-num:ui-monospace,"Cascadia Mono","SF Mono",Menlo,Consolas,monospace}
html[data-graphic-style="pro"] body:not([data-theme]){--bg:#0a0f13;--side:#0d1419;--card:#111a21;--card-border:#1f2d38;--line:#1a2630;--txt:#e7edf2;--txt-muted:#7f929f;--acc:#ffb020;--acc-hover:#e69a0c;--success:#3ddc97;--warning:#ff8a3d;--purple:#a193ff;--shadow:none;--soft-glow:none}
html[data-graphic-style="pro"] body[data-theme="grigio"]{--acc:#ffb020;--acc-hover:#e69a0c;--success:#3ddc97;--shadow:none;--soft-glow:none}
html[data-graphic-style="pro"] body{background-color:var(--bg);background-image:linear-gradient(color-mix(in srgb,var(--txt) 3.2%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--txt) 3.2%,transparent) 1px,transparent 1px);background-size:44px 44px}
html[data-graphic-style="pro"] :focus-visible{outline:2px solid var(--acc);outline-offset:2px}

/* barra laterale */
html[data-graphic-style="pro"] .side{background:var(--side);box-shadow:none;border-right:1px solid var(--line)}
html[data-graphic-style="pro"] .brand{border-bottom:1px solid var(--line)}
html[data-graphic-style="pro"] .brand-logo{border-radius:6px}
html[data-graphic-style="pro"] .logo-tag{font-family:var(--p-num);text-transform:none;letter-spacing:.06em;font-size:.7rem;color:var(--acc)}
html[data-graphic-style="pro"] .brand-title{letter-spacing:-.02em}
html[data-graphic-style="pro"] .side label{display:flex;align-items:center;gap:8px;text-transform:none;letter-spacing:0;font-size:.74rem;font-weight:600;color:var(--txt-muted);margin:20px 0 8px}
html[data-graphic-style="pro"] .side label::after{content:"";flex:1;height:1px;background:var(--line)}
html[data-graphic-style="pro"] .side input,html[data-graphic-style="pro"] .side select{background:var(--bg);border-radius:6px;font-family:var(--p-num);font-size:.82rem}
html[data-graphic-style="pro"] .year-item{background:transparent;border:0;border-left:2px solid transparent;border-radius:0 6px 6px 0;padding:9px 12px;margin:0 0 2px;font-family:var(--p-num);font-weight:600;font-size:.86rem;color:var(--txt-muted);box-shadow:none}
html[data-graphic-style="pro"] .year-item:hover{transform:none;background:color-mix(in srgb,var(--txt) 5%,transparent);color:var(--txt);border-left-color:var(--line)}
html[data-graphic-style="pro"] .year-item.active{background:color-mix(in srgb,var(--acc) 14%,transparent);border-left-color:var(--acc);color:var(--txt);box-shadow:none}
html[data-graphic-style="pro"] .btn-sm{border-radius:6px;background:var(--acc);color:#1a1205}
html[data-graphic-style="pro"] .style-switch{grid-template-columns:repeat(3,1fr)}
html[data-graphic-style="pro"] .style-choice{border-radius:6px;padding:8px 4px;font-size:11.5px}
html[data-graphic-style="pro"] .style-choice.active{background:color-mix(in srgb,var(--acc) 16%,transparent);color:var(--txt);border-color:var(--acc)}

/* testata e pulsanti */
html[data-graphic-style="pro"] .top h1{font-size:2rem;font-weight:700;letter-spacing:-.035em}
html[data-graphic-style="pro"] .btn{border-radius:6px;background:transparent;font-weight:600}
html[data-graphic-style="pro"] .btn:hover{background:color-mix(in srgb,var(--acc) 9%,transparent)}
html[data-graphic-style="pro"] .btn.primary{background:var(--acc);color:#1a1205}

/* pannelli con angoli segnati */
html[data-graphic-style="pro"] .section-card,html[data-graphic-style="pro"] .chart-card,html[data-graphic-style="pro"] .month-card{position:relative;background:var(--card);border:1px solid var(--card-border);border-radius:8px;box-shadow:none}
html[data-graphic-style="pro"] .section-card:hover{border-color:var(--card-border)}
html[data-graphic-style="pro"] .section-card::before,html[data-graphic-style="pro"] .chart-card::before{content:"";position:absolute;top:-1px;left:-1px;width:14px;height:14px;border-top:2px solid var(--acc);border-left:2px solid var(--acc);border-top-left-radius:8px;pointer-events:none}
html[data-graphic-style="pro"] .section-card::after,html[data-graphic-style="pro"] .chart-card::after{content:"";position:absolute;bottom:-1px;right:-1px;width:14px;height:14px;border-bottom:2px solid var(--acc);border-right:2px solid var(--acc);border-bottom-right-radius:8px;pointer-events:none}
html[data-graphic-style="pro"] .section-card>h3 i:first-child{color:var(--acc)}
html[data-graphic-style="pro"] .summary-pill{border-radius:4px;font-family:var(--p-num);background:transparent}
html[data-graphic-style="pro"] .rate-box{background:transparent;border:1px dashed var(--card-border);border-radius:6px}
html[data-graphic-style="pro"] .rate-box input,html[data-graphic-style="pro"] .ticket-box input{font-family:var(--p-num);border-radius:6px}

/* riquadri: il primo è il numero guida */
html[data-graphic-style="pro"] .summary{grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
html[data-graphic-style="pro"] .summary .stat:first-child{grid-column:span 2;grid-row:span 2}
html[data-graphic-style="pro"] .stat{--neon:var(--acc);min-height:0;padding:14px 16px!important;background:var(--card)!important;border:1px solid var(--card-border)!important;border-left:3px solid var(--neon)!important;border-radius:6px;box-shadow:none!important;color:var(--txt)}
html[data-graphic-style="pro"] .stat::before,html[data-graphic-style="pro"] .stat::after{display:none!important}
html[data-graphic-style="pro"] .stat:hover{transform:none;border-color:var(--card-border)!important;border-left-color:var(--neon)!important}
html[data-graphic-style="pro"] .stat .lbl,html[data-graphic-style="pro"] .summary .stat .lbl,html[data-graphic-style="pro"] .month-summary .stat .lbl{color:var(--txt-muted)!important;text-transform:none;font-size:.78rem;font-weight:600;letter-spacing:0;line-height:1.3}
html[data-graphic-style="pro"] .stat .val,html[data-graphic-style="pro"] .summary .stat .val,html[data-graphic-style="pro"] .month-summary .stat .val{color:var(--neon)!important;text-shadow:none!important;font-family:var(--p-num);font-size:1.55rem;font-weight:700;letter-spacing:-.045em;font-variant-numeric:tabular-nums}
html[data-graphic-style="pro"] .summary .stat:first-child{display:flex;flex-direction:column;justify-content:space-between;padding:20px 22px!important}
html[data-graphic-style="pro"] .summary .stat:first-child .val{font-size:clamp(2.6rem,4.4vw,4.2rem)}
html[data-graphic-style="pro"] .summary .stat:nth-child(2){--neon:#ffcf70}
html[data-graphic-style="pro"] .summary .stat:nth-child(3){--neon:#9fb3c2}
html[data-graphic-style="pro"] .summary .stat:nth-child(4){--neon:#5ec8ff}
html[data-graphic-style="pro"] .summary .stat:nth-child(5){--neon:var(--success)}
html[data-graphic-style="pro"] .summary .stat:nth-child(6){--neon:var(--warning)}
html[data-graphic-style="pro"] .summary .stat:nth-child(7){--neon:var(--purple)}
html[data-graphic-style="pro"] .month-summary .stat{--neon:var(--acc)}
html[data-graphic-style="pro"] .month-summary .stat.euro{--neon:var(--success)}
html[data-graphic-style="pro"] .month-summary .stat.rep{--neon:var(--warning)}
html[data-graphic-style="pro"] .month-summary .stat.recup{--neon:var(--purple)}

/* mesi e tabelle */
html[data-graphic-style="pro"] .months{gap:14px}
html[data-graphic-style="pro"] .month-card{overflow:hidden}
html[data-graphic-style="pro"] .month-head{background:transparent;position:relative;padding:14px 16px 14px 19px}
html[data-graphic-style="pro"] .month-head::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--acc)}
html[data-graphic-style="pro"] .month-head:has(.closed-mark)::before{background:var(--success)}
html[data-graphic-style="pro"] .month-head h3{font-size:1.08rem;letter-spacing:-.02em}
html[data-graphic-style="pro"] .month-head .sub{font-family:var(--p-num);font-size:.74rem}
html[data-graphic-style="pro"] .month-body{border-top:1px solid var(--line)}
html[data-graphic-style="pro"] .closed-mark{border-radius:4px;font-family:var(--p-num)}
html[data-graphic-style="pro"] th{text-transform:none;letter-spacing:0;font-size:.74rem;font-weight:600;border-bottom:1px solid var(--card-border)}
html[data-graphic-style="pro"] td{border-bottom:1px solid color-mix(in srgb,var(--line) 65%,transparent);padding:3px 4px}
html[data-graphic-style="pro"] tbody tr:hover td{background:color-mix(in srgb,var(--txt) 4%,transparent)}
html[data-graphic-style="pro"] td input[type=date],html[data-graphic-style="pro"] td input[type=number],html[data-graphic-style="pro"] td input[type=text]{background:transparent;border:1px solid transparent;border-radius:4px;font-family:var(--p-num)}
html[data-graphic-style="pro"] td input[type=number]{text-align:right}
html[data-graphic-style="pro"] td input[type=date]:hover,html[data-graphic-style="pro"] td input[type=number]:hover,html[data-graphic-style="pro"] td input[type=text]:hover{border-color:var(--line)}
html[data-graphic-style="pro"] td input[type=date]:focus,html[data-graphic-style="pro"] td input[type=number]:focus,html[data-graphic-style="pro"] td input[type=text]:focus{border-color:var(--acc);background:var(--bg);outline:none}
html[data-graphic-style="pro"] .month-tot{font-family:var(--p-num);font-size:.8rem}
html[data-graphic-style="pro"] .month-closebar{border-radius:6px}
html[data-graphic-style="pro"] .month-close-btn{border-radius:6px}
html[data-graphic-style="pro"] .add-row{border-radius:6px}
html[data-graphic-style="pro"] .note-item,html[data-graphic-style="pro"] .ticket-total{border-radius:6px}

@media(max-width:1100px){html[data-graphic-style="pro"] .summary{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:760px){
  html[data-graphic-style="pro"] .summary{grid-template-columns:repeat(2,minmax(0,1fr))}
  html[data-graphic-style="pro"] .summary .stat:first-child{grid-row:auto;grid-column:span 2}
  html[data-graphic-style="pro"] .year-item{border-left:0;border-bottom:2px solid transparent;border-radius:6px 6px 0 0}
  html[data-graphic-style="pro"] .year-item.active{border-bottom-color:var(--acc)}
}
</style>

<style id="agenda-oncall">
.agenda-day.oncall{background:color-mix(in srgb,#f472b6 20%,var(--card));border-color:color-mix(in srgb,#f472b6 55%,transparent);color:var(--txt)}
.agenda-day.oncall.oc-start{border-top-left-radius:12px;border-bottom-left-radius:12px}
.agenda-day.oncall.oc-end{border-top-right-radius:12px;border-bottom-right-radius:12px}
.agenda-day.oncall .oc{position:absolute;left:4px;right:auto;bottom:3px;font-size:.55rem;color:#f472b6;pointer-events:none}
.agenda-legend i.oncall{background:#f472b6}
.agenda-oncall{display:flex;align-items:center;gap:11px;margin:0 0 9px;padding:11px 12px;border:1px solid color-mix(in srgb,#f472b6 55%,var(--line));border-radius:12px;background:color-mix(in srgb,#f472b6 10%,var(--card))}
.agenda-oncall>i{flex:0 0 auto;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:color-mix(in srgb,#f472b6 22%,transparent);color:#f472b6;font-size:.85rem}
.agenda-oncall strong{display:block;font-size:.82rem}
.agenda-oncall span{display:block;margin-top:2px;color:var(--txt-muted);font-size:.66rem;line-height:1.35}
.agenda-oncall.now{border-color:#f472b6;box-shadow:0 0 0 1px #f472b655,0 0 22px #f472b626}
.agenda-oncall.none{border-color:var(--line);background:transparent;opacity:.75}
.agenda-oncall.none>i{background:var(--line);color:var(--txt-muted)}
</style>
<script id="monthly-agenda-runtime">
function agendaMonthIndex(){
  if(currentMonthFilter!=='')return Math.max(0,Math.min(11,parseInt(currentMonthFilter,10)||0));
  const now=new Date();if(Number(currentYear)===now.getFullYear())return now.getMonth();
  const y=DATA[String(currentYear)];if(y&&y.months){for(let i=11;i>=0;i--){const m=y.months[i];if((m.entries||[]).some(e=>(Number(e.ore)||0)>0||e.lavorato||e.rep||e.recup)||Number(y.ticketMonths&&y.ticketMonths[i])>0)return i;}}
  return 0;
}
function agendaIsOnCall(iso){
  const y=DATA[iso.slice(0,4)];if(!y||!y.reperibilitaDays)return false;
  const m=y.reperibilitaDays[Number(iso.slice(5,7))-1];if(!m||!m.entries)return false;
  return m.entries.some(e=>e.date===iso&&e.rep);
}
function agendaOncallInfo(){
  const today=todayISO();let start=null;
  for(let i=0;i<=400;i++){const d=addDaysISO(today,i);if(agendaIsOnCall(d)){start=d;break;}}
  if(!start)return null;
  const now=start===today;let from=start;
  if(now){while(agendaIsOnCall(addDaysISO(from,-1)))from=addDaysISO(from,-1);}
  let to=start,len=1;
  while(agendaIsOnCall(addDaysISO(to,1))){to=addDaysISO(to,1);len++;}
  if(now){len=1;for(let d=from;d!==to;d=addDaysISO(d,1))len++;}
  const until=Math.round((new Date(from+'T12:00:00')-new Date(today+'T12:00:00'))/86400000);
  return {now,from,to,len,until};
}
function agendaFmtDay(iso){return new Date(iso+'T12:00:00').toLocaleDateString('it-IT',{weekday:'short',day:'numeric',month:'short'});}
function renderAgendaOncall(mIdx){
  const box=document.getElementById('agendaOncall');if(!box)return;
  const y=ensureYear(currentYear),monthDays=((y.reperibilitaDays&&y.reperibilitaDays[mIdx]&&y.reperibilitaDays[mIdx].entries)||[]).filter(e=>e.rep).length;
  const info=agendaOncallInfo();
  if(!info){box.className='agenda-oncall none';box.innerHTML='<i class="fa-solid fa-phone-volume"></i><div><strong>Nessuna reperibilità in programma</strong><span>Segnala i giorni nella pagina Reperibilità.</span></div>';return;}
  const when=info.now?'Sei reperibile adesso':(info.until===1?'Reperibile da domani':'Prossima reperibilità tra '+info.until+' giorni');
  box.className='agenda-oncall'+(info.now?' now':'');
  box.innerHTML=`<i class="fa-solid fa-phone-volume"></i><div><strong>${when}</strong><span>${agendaFmtDay(info.from)} → ${agendaFmtDay(info.to)} · ${info.len} ${info.len===1?'giorno':'