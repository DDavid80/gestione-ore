ecedente`;};
  const scanMonths=currentMonthFilter===''?Array.from({length:12},(_,i)=>i):[mIdx];
  let anomalies=[];
  scanMonths.forEach(i=>{
    const m=y.months&&y.months[i];if(!m)return;
    const seen=new Set();
    (m.entries||[]).forEach((e,j)=>{
      const date=(e.date||'').trim();const hasData=(Number(e.ore)||0)!==0||!!e.lavorato||!!e.rep||!!e.recup||!!(e.note||'').trim();
      if(!date){if(hasData)anomalies.push(`${MONTHS[i]} · riga con dati senza data`);return;}
      if(!insightDateValid(date)){anomalies.push(`${MONTHS[i]} · data non valida alla riga ${j+1}`);return;}
      if(!date.startsWith(`${currentYear}-${String(i+1).padStart(2,'0')}-`)) anomalies.push(`${MONTHS[i]} · data fuori dal mese selezionato`);
      if(seen.has(date)) anomalies.push(`${MONTHS[i]} · data duplicata ${date.slice(8,10)}/${date.slice(5,7)}`);
      seen.add(date);
      if(e.ore!==undefined&&String(e.ore).trim()!==''&&(!Number.isFinite(Number(e.ore))||Number(e.ore)<0)) anomalies.push(`${MONTHS[i]} · ore da verificare (${date.slice(8,10)}/${date.slice(5,7)})`);
    });
  });
  anomalies=[...new Set(anomalies)];
  const today=todayISO(),now=new Date(),isCurrentMonth=Number(currentYear)===now.getFullYear()&&mIdx===now.getMonth();
  let forecastHtml='';
  if(!isCurrentMonth) forecastHtml='<div class="insight-big">—</div><div class="insight-sub">La previsione si attiva sul mese corrente dell’anno corrente.</div>';
  else if(y.months&&y.months[mIdx]&&y.months[mIdx].closed) forecastHtml='<div class="insight-big">Mese chiuso</div><div class="insight-sub">I totali consuntivi sono già disponibili sopra.</div>';
  else {
    const entries=(y.months&&y.months[mIdx]&&y.months[mIdx].entries)||[];
    let actualHours=0,worked=0,actualTicketEuro=0,elapsedWeekdays=0,remainingWeekdays=0;
    const days=new Date(Number(currentYear),mIdx+1,0).getDate();
    for(let d=1;d<=days;d++){
      const dt=new Date(Number(currentYear),mIdx,d);const wd=dt.getDay();
      const iso=`${currentYear}-${String(mIdx+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
      if(wd===0||wd===6||italianHolidayName(iso))continue;
      if(iso<=today)elapsedWeekdays++;else remainingWeekdays++;
    }
    entries.forEach(e=>{if(e.date&&e.date<=today){actualHours+=Number(e.ore)||0;if(e.lavorato){worked++;actualTicketEuro+=ticketRateForDate(Number(currentYear),e.date);}}});
    if(worked>0&&elapsedWeekdays>0){
      const estimatedRemaining=worked/elapsedWeekdays*remainingWeekdays;
      const forecastWorked=worked+estimatedRemaining;
      const avgHours=actualHours/worked;
      const forecastHours=actualHours+avgHours*estimatedRemaining;
      const rate=(typeof ticketRateForDate==='function')?ticketRateForDate(Number(currentYear),today):0;
      const forecastTicketEuro=actualTicketEuro+estimatedRemaining*rate;
      forecastHtml=`<div class="insight-row"><span>Ore inserite finora</span><strong>${actualHours.toFixed(2)} h</strong></div><div class="insight-row"><span>Ore stimate a fine mese</span><strong>${forecastHours.toFixed(2)} h</strong></div><div class="insight-row"><span>Ticket stimati</span><strong>${forecastWorked.toFixed(1)} gg · €${forecastTicketEuro.toFixed(2)}</strong></div><div class="insight-note">Stima basata sui giorni segnati come lavorati e sulla media registrata finora. È indicativa, non un consuntivo.</div>`;
    }else forecastHtml='<div class="insight-big">In attesa dei dati</div><div class="insight-sub">Segna almeno un giorno come lavorato per attivare la previsione.</div>';
  }
  const anomalyHtml=anomalies.length?anomalies.slice(0,5).map(a=>`<div class="insight-alert"><i class="fa-solid fa-triangle-exclamation"></i><span>${a}</span></div>`).join('')+(anomalies.length>5?`<div class="insight-note">Altre ${anomalies.length-5} verifiche da controllare.</div>`:''):`<div class="insight-alert"><i class="fa-solid fa-circle-check"></i><span class="insight-ok">Nessuna anomalia rilevata nei campi controllati.</span></div>`;
  box.innerHTML=`<article class="insight-card"><h3 class="insight-head"><span class="insight-icon"><i class="fa-solid fa-calendar-days"></i></span>Riepilogo mensile</h3><div class="insight-sub">${monthName} ${currentYear} · confronto con ${MONTHS[prevIndex].charAt(0)+MONTHS[prevIndex].slice(1).toLowerCase()} ${prevYear}</div><div class="insight-row"><span>Ore straordinarie</span><strong>${cur.hours.toFixed(2)} h</strong></div><div class="insight-delta">${delta(cur.hours,prev.hours)}</div><div class="insight-row"><span>Importo straordinari</span><strong>€${cur.euro.toFixed(2)}</strong></div><div class="insight-row"><span>Giorni lavorati</span><strong>${cur.worked}</strong></div><div class="insight-row"><span>Ticket maturati / registrati</span><strong>${cur.ticketDays} gg · €${cur.ticketEuro.toFixed(2)}</strong></div><div class="insight-delta">${delta(cur.ticketEuro,prev.ticketEuro)}</div></article><article class="insight-card"><h3 class="insight-head"><span class="insight-icon"><i class="fa-solid fa-shield-halved"></i></span>Controllo dati</h3><div class="insight-sub">${currentMonthFilter===''?'Controllo su tutto l’anno':'Controllo sul mese selezionato'} · date, duplicati e valori ore</div>${anomalyHtml}</article><article class="insight-card insight-forecast"><h3 class="insight-head"><span class="insight-icon"><i class="fa-solid fa-chart-line"></i></span>Stima fine mese</h3><div class="insight-sub">Previsione automatica · ${isCurrentMonth?monthName+' '+currentYear:'non disponibile per questo periodo'}</div>${forecastHtml}</article>`;
}
const _insightsSaveData=saveData;
saveData=function(){_insightsSaveData();if(typeof renderDashboardInsights==='function')renderDashboardInsights();};
const _insightsRenderAll=renderAll;
renderAll=function(){_insightsRenderAll();renderDashboardInsights();};
const _insightsMonthSummary=renderMonthSummary;
renderMonthSummary=function(){_insightsMonthSummary();renderDashboardInsights();};
renderDashboardInsights();
</script>
<style id="agenda-cover-design">
#coverScreen{position:fixed;inset:0;z-index:9999;display:flex;align-items:stretch;justify-content:stretch;padding:0;overflow:auto;background:#07111b;transition:opacity .3s,visibility .3s}
#coverScreen.hidden{opacity:0;visibility:hidden;pointer-events:none}
#coverScreen .cover-bg{position:fixed;inset:0;background:radial-gradient(ellipse at 14% 10%,#ffb34122,transparent 36%),radial-gradient(ellipse at 90% 84%,#20cde022,transparent 42%),linear-gradient(128deg,#0b1119 0%,#0e1823 48%,#07121c 100%)}
#coverScreen .cover-bg:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 0 49.9%,#ffffff05 50%,transparent 50.1%),linear-gradient(0deg,transparent 0 49.9%,#ffffff04 50%,transparent 50.1%);background-size:74px 74px;mask-image:linear-gradient(120deg,#0009,transparent 70%)}
#coverScreen .cover-inner{position:relative;width:100%;max-width:none;min-height:100vh;margin:0;padding:clamp(24px,5.2vw,78px) clamp(20px,6.4vw,100px) 24px;border:0;border-radius:0;box-shadow:none;background:transparent;backdrop-filter:none;overflow:visible;text-align:left;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);grid-template-rows:auto 1fr auto;gap:clamp(22px,4vw,54px);align-items:center}
#coverScreen .cover-toprow{grid-column:1 / -1;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid #ffffff18;padding-bottom:18px}
#coverScreen .cover-brandblock{display:flex;align-items:center;gap:13px}.cover-logo{display:none!important}.cover-logo:has(img){display:block!important;width:44px;height:44px;margin:0;border-radius:12px;border-color:#ffffff2b;background:#ffffff09;box-shadow:none}.cover-logo img{display:block}
#coverScreen .cover-kicker{color:#61d8e9;font-size:.62rem;letter-spacing:.18em;margin:0 0 4px}#coverScreen .cover-title{font-size:1rem;line-height:1.2;letter-spacing:.02em;margin:0;color:#f6fbff}
#coverScreen .cover-datebox{text-align:right;display:grid;gap:3px}.cover-datebox span{font-size:.56rem;letter-spacing:.17em;color:#8fa5b9;font-weight:900}.cover-datebox strong{font-size:.76rem;color:#d3deea;text-transform:capitalize}.cover-datebox b{font-size:.65rem;color:#ffbd57;letter-spacing:.08em}
#coverScreen .cover-hero{align-self:center;max-width:690px}.cover-overline{color:#ffbd57;text-transform:uppercase;letter-spacing:.19em;font-size:.65rem;font-weight:900;margin-bottom:15px}.cover-hero h1{font-size:clamp(2.7rem,6.3vw,6.2rem);line-height:.96;letter-spacing:-.065em;margin:0;color:#f6f8fc;font-weight:850}.cover-hero h1 em{font-style:normal;color:#39d2e8;text-shadow:0 0 38px #23d4f435}.cover-hero p{color:#a2b2c3;font-size:clamp(.9rem,1.2vw,1.05rem);max-width:480px;line-height:1.65;margin:18px 0 25px}.cover-shortcuts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-width:470px}.cover-shortcuts button{display:flex;align-items:center;gap:10px;text-align:left;background:#ffffff08;border:1px solid #ffffff18;border-radius:10px;padding:11px 12px;color:#c9d5e2;cursor:pointer;transition:.18s}.cover-shortcuts button:hover{background:#ffffff12;border-color:#41cfe2;color:#fff;transform:translateY(-1px)}.cover-shortcuts button i{width:18px;color:#ffbd57}.cover-shortcuts button span{flex:1;font-size:.72rem;font-weight:750}.cover-shortcuts button b{font-size:1.1rem;color:#43d5e8;font-weight:500}
#coverScreen .cover-month-card{width:100%;max-width:560px;justify-self:end;padding:22px;border:1px solid #ffffff20;border-radius:20px;background:linear-gradient(150deg,#111f2be8,#0a141ee8);box-shadow:0 24px 72px #0006,inset 0 1px #ffffff12;backdrop-filter:blur(20px)}.cover-card-head{display:flex;justify-content:space-between;align-items:start;gap:10px;margin-bottom:18px}.cover-card-kicker{font-size:.59rem;color:#91a7bb;letter-spacing:.15em;font-weight:900}.cover-card-head h2{font-size:1.35rem;line-height:1.2;margin:5px 0 0;color:#f5f8fb}.cover-status,.agenda-status{font-size:.56rem;letter-spacing:.08em;font-weight:900;color:#31d79a;border:1px solid #31d79a58;background:#31d79a12;border-radius:999px;padding:7px 9px;white-space:nowrap}.cover-status.closed,.agenda-status.closed{color:#ffb341;border-color:#ffb34165;background:#ffb34113}
#coverScreen .cover-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:0}#coverScreen .cover-stat{--cover-neon:#21cde5;min-height:76px;display:grid;grid-template-columns:38px 1fr;grid-template-rows:auto auto;align-items:center;column-gap:10px;padding:11px;border:1px solid color-mix(in srgb,var(--cover-neon) 45%,transparent);border-radius:12px;background:linear-gradient(140deg,color-mix(in srgb,var(--cover-neon) 9%,#0a1520),#0a131e);text-align:left}#coverScreen .cover-stat:nth-child(2){--cover-neon:#ffb341}#coverScreen .cover-stat:nth-child(3){--cover-neon:#26d99e}#coverScreen .cover-stat:nth-child(4){--cover-neon:#b77aff}#coverScreen .cover-stat .ci{grid-row:1 / 3;width:34px;height:34px;margin:0;border:1px solid color-mix(in srgb,var(--cover-neon) 65%,transparent);border-radius:10px;color:var(--cover-neon);background:#08111b;box-shadow:0 0 16px color-mix(in srgb,var(--cover-neon) 15%,transparent)}#coverScreen .cover-stat .cv{font-size:1.06rem;line-height:1.1;text-align:left;color:var(--cover-neon);font-weight:850;white-space:nowrap}#coverScreen .cover-stat .cl{font-size:.55rem;text-align:left;color:#a3b5c7;letter-spacing:.07em;margin-top:3px}
.cover-card-foot{margin:13px 0 15px;padding:10px 0 0;border-top:1px solid #ffffff14;color:#8499ad;font-size:.63rem;line-height:1.45}.cover-card-foot i{color:#64d5e8;margin-right:5px}#coverScreen .cover-btn{display:flex;width:100%;justify-content:space-between;align-items:center;background:linear-gradient(105deg,#ffb341,#f48e3d);color:#16130e;border:0;border-radius:11px;padding:13px 15px;font-size:.78rem;font-weight:900;box-shadow:0 10px 26px #ffab3430;cursor:pointer}#coverScreen .cover-btn:hover{filter:brightness(1.07);transform:translateY(-1px)}#coverScreen .cover-year-btn{width:100%;margin-top:8px;border:1px solid #ffffff1f;border-radius:10px;padding:10px;background:#ffffff08;color:#c4d1de;font-size:.7rem;font-weight:750;cursor:pointer}#coverScreen .cover-year-btn:hover{border-color:#40cde2;color:#fff}.cover-year-btn i{margin-left:6px;color:#40cde2}
#coverScreen .cover-foot{grid-column:1 / -1;width:100%;display:flex;justify-content:space-between;gap:15px;margin:0;padding-top:12px;border-top:1px solid #ffffff13;color:#71869a;font-size:.6rem}#coverScreen .cover-foot span:first-child i{color:#45d4e5;margin-right:5px}
.agenda-home{position:relative;isolation:isolate;overflow:hidden;margin:0 0 22px;padding:clamp(17px,2.6vw,30px);border:1px solid var(--card-border);border-radius:20px;background:radial-gradient(ellipse at 90% 5%,color-mix(in srgb,var(--warning) 12%,transparent),transparent 38%),linear-gradient(135deg,color-mix(in srgb,var(--card) 94%,var(--acc) 6%),var(--card));box-shadow:var(--shadow)}.agenda-home:after{content:"";position:absolute;z-index:-1;width:320px;height:320px;border-radius:50%;right:-170px;bottom:-205px;background:color-mix(in srgb,var(--acc) 13%,transparent);filter:blur(18px)}.agenda-home-head{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:18px}.agenda-kicker{font-size:.62rem;color:var(--warning);letter-spacing:.15em;font-weight:900}.agenda-home-head h2{font-size:clamp(1.45rem,2.7vw,2.05rem);letter-spacing:-.04em;margin:4px 0}.agenda-home-head p{font-size:.78rem;color:var(--txt-muted);margin:0}.agenda-selects{display:flex;align-items:center;gap:8px}.agenda-selects label{font-size:.63rem;color:var(--txt-muted);text-transform:uppercase;font-weight:800}.agenda-selects select{min-width:130px;background:var(--bg);color:var(--txt);border:1px solid var(--line);padding:8px 10px;border-radius:9px;font-size:.76rem}.agenda-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(270px,.75fr);gap:14px}.agenda-calendar-wrap,.agenda-summary{border:1px solid var(--line);border-radius:14px;background:color-mix(in srgb,var(--bg) 46%,transparent);padding:13px}.agenda-weekdays,.agenda-calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}.agenda-weekdays{margin-bottom:5px}.agenda-weekdays span{text-align:center;color:var(--txt-muted);font-size:.54rem;font-weight:900;letter-spacing:.06em;padding:4px}.agenda-day{position:relative;min-height:42px;border:1px solid transparent;background:color-mix(in srgb,var(--card) 78%,transparent);border-radius:8px;color:var(--txt);cursor:pointer;padding:5px 6px;text-align:left;transition:.14s}.agenda-day:hover{border-color:var(--acc);transform:translateY(-1px)}.agenda-day .n{display:block;font-size:.67rem;font-weight:800}.agenda-day .mark{display:block;height:4px;width:4px;border-radius:50%;background:transparent;margin-top:3px}.agenda-day.worked .mark{background:var(--success);box-shadow:0 0 7px var(--success)}.agenda-day.has-hours:after{content:"";position:absolute;right:6px;top:6px;width:5px;height:5px;border-radius:50%;background:var(--acc)}.agenda-day.rep{box-shadow:inset 0 -2px var(--warning)}.agenda-day.weekend{color:var(--txt-muted);background:color-mix(in srgb,var(--line) 50%,var(--card))}.agenda-day.holiday{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 38%,transparent)}.agenda-day.today{outline:1px solid var(--warning);outline-offset:1px}.agenda-day.empty{visibility:hidden;pointer-events:none}.agenda-legend{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px;color:var(--txt-muted);font-size:.57rem}.agenda-legend span{display:flex;align-items:center;gap:5px}.agenda-legend i{width:7px;height:7px;border-radius:50%;background:var(--acc)}.agenda-legend i.worked{background:var(--success)}.agenda-legend i.hours{background:var(--acc)}.agenda-legend i.rep{background:var(--warning)}.agenda-legend i.holiday{background:var(--danger)}.agenda-summary-title{font-size:.73rem;font-weight:850;margin-bottom:10px}.agenda-kpis{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.agenda-kpi{border:1px solid color-mix(in srgb,var(--k) 43%,var(--line));border-radius:10px;padding:9px;background:color-mix(in srgb,var(--k) 8%,var(--card))}.agenda-kpi strong{display:block;color:var(--k);font-size:1rem}.agenda-kpi span{display:block;color:var(--txt-muted);font-size:.54rem;text-transform:uppercase;letter-spacing:.04em;margin-top:4px}.agenda-quick{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:9px}.agenda-quick button{display:flex;justify-content:space-between;align-items:center;gap:5px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--txt);padding:8px;font-size:.58rem;cursor:pointer}.agenda-quick button:hover{border-color:var(--acc)}.agenda-quick i{color:var(--acc);margin-right:4px}.agenda-quick b{color:var(--txt-muted);font-size:.53rem;white-space:nowrap}.agenda-month-btn{width:100%;margin-top:8px;padding:9px;border:0;border-radius:8px;background:linear-gradient(100deg,var(--acc),var(--acc-hover));color:#fff;font-size:.65rem;font-weight:850;cursor:pointer}.agenda-month-btn i{margin-left:5px}.agenda-month-btn:hover{filter:brightness(1.08)}
@media(max-width:900px){#coverScreen .cover-inner{grid-template-columns:1fr;grid-template-rows:auto auto auto auto;gap:24px;padding:24px}.cover-hero{max-width:760px}.cover-hero h1{font-size:clamp(2.6rem,8vw,5rem)}#coverScreen .cover-month-card{justify-self:start;max-width:700px}.agenda-layout{grid-template-columns:1fr}.agenda-summary{display:grid;grid-template-columns:1fr 1.2fr;gap:10px;align-items:start}.agenda-summary-title{grid-column:1/-1;margin-bottom:0}.agenda-kpis{grid-column:1}.agenda-quick{grid-column:2;grid-row:2}.agenda-month-btn{grid-column:1/-1}}
@media(max-width:560px){#coverScreen .cover-inner{padding:19px 15px 15px;gap:23px}.cover-datebox strong{font-size:.65rem}.cover-datebox b{font-size:.58rem}.cover-brandblock{gap:8px}.cover-kicker{font-size:.53rem!important}#coverScreen .cover-title{font-size:.9rem!important}.cover-hero h1{font-size:clamp(2.35rem,11vw,3.3rem)}.cover-shortcuts{gap:6px}.cover-shortcuts button{padding:9px 8px;g