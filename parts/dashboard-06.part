TML = MONTHS.map((name, mIdx)=>{
    const entries = y.reperibilitaDays[mIdx].entries;
    const cnt = entries.filter(e=>e.rep).length;
    totYear += cnt;
    const isOpen = repOpenMonths.has(mIdx);
    const rows = entries.map((e,eIdx)=>{
      const weekend = weekendInfo(e.date);
      return `
      <div class="rep-day-row ${weekend.className}">
        <label><input type="checkbox" ${e.rep?'checked':''} onchange="toggleRepDay(${mIdx},${eIdx},this.checked)"> <span>${formatDateIT(e.date)}</span>${weekend.badge}</label>
      </div>`;
    }).join('');
    return `
      <div class="month-card">
        <div class="month-head" onclick="toggleRepMonth(${mIdx})">
          <div>
            <h3>${name}</h3>
            <div class="sub"><span style="color:var(--warning);font-weight:700;">${cnt} giorni reperibili</span></div>
          </div>
          <i class="fa-solid fa-chevron-down"></i>
        </div>
        <div class="month-body ${isOpen?'open':''}" id="repmbody-${mIdx}">${rows}</div>
      </div>`;
  }).join('');
  document.getElementById('repYearTotal').textContent = totYear;
  document.getElementById('repYearWeeks').textContent = (totYear/7).toFixed(1);
}

function toggleSection(id){
  const body = document.getElementById(id);
  const chevron = document.getElementById(id+'Chevron');
  body.classList.toggle('closed');
  if(chevron) chevron.classList.toggle('closed');
}

initBrand();
initTheme();
initYears();
populateMonthFilter();
renderAll();
</script>
</body>
<style id="graphic-style-controls">.style-switch{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:6px}.style-choice{border:1px solid var(--card-border);background:transparent;color:var(--txt-muted);border-radius:10px;padding:8px 6px;font:600 12px inherit;cursor:pointer;transition:.2s}.style-choice:hover{border-color:var(--acc);color:var(--txt)}.style-choice.active{background:var(--acc);border-color:var(--acc);color:#fff}</style>
<script>
function setGraphicStyle(style){style=style==='ios'?'ios':(style==='pro'?'pro':'base');document.querySelectorAll('style#ios-glass-design').forEach(s=>{s.disabled=style!=='ios';if(s.sheet)s.sheet.disabled=style!=='ios'});document.documentElement.dataset.graphicStyle=style;try{localStorage.setItem('strao_graphic_style_v1',style)}catch(e){}document.querySelectorAll('.style-choice').forEach(b=>b.classList.toggle('active',b.dataset.style===style));try{if(typeof renderAll==='function'&&typeof currentYear!=='undefined'&&currentYear&&window.__graphicReady)renderAll()}catch(e){}}
setGraphicStyle(localStorage.getItem('strao_graphic_style_v1')||'base');
window.__DEFAULT_BACKUP_GZIP='